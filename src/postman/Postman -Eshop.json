					"listen": "test",
					"script": {
						"exec": [
							"// Test for status code\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Test for response time\r",
							"pm.test(\"Response time is less than 3000ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
							"});\r",
							"\r",
							"// Test for response body properties\r",
							"const responseBody = pm.response.json();\r",
							"pm.test(\"Response contains catalogItems\", function () {\r",
							"    pm.expect(responseBody).to.have.property('catalogItems');\r",
							"});\r",
							"pm.test(\"Each catalogItem has id, name, description, price, pictureUri, catalogTypeId, catalogBrandId\", function () {\r",
							"    responseBody.catalogItems.forEach((item) => {\r",
							"        pm.expect(item).to.have.property('id');\r",
							"        pm.expect(item).to.have.property('name');\r",
							"        pm.expect(item).to.have.property('description');\r",
							"        pm.expect(item).to.have.property('price');\r",
							"        pm.expect(item).to.have.property('pictureUri');\r",
							"        pm.expect(item).to.have.property('catalogTypeId');\r",
							"        pm.expect(item).to.have.property('catalogBrandId');\r",
							"    });\r",
							"});\r",
							"pm.test(\"Response contains pageCount\", function () {\r",
							"    pm.expect(responseBody).to.have.property('pageCount');\r",
							"});\r",
							"\r",
							"pm.test(\"Response status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"pm.test(\"Response contains catalogItems array\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.be.an('object');\r",
							"    pm.expect(responseData.catalogItems).to.exist.and.to.be.an('array');\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Each catalogItem has valid properties\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData.catalogItems).to.be.an('array').that.is.not.empty;\r",
							"\r",
							"    responseData.catalogItems.forEach(function(catalogItem) {\r",
							"        pm.expect(catalogItem).to.have.property('id').that.is.a('number');\r",
							"        pm.expect(catalogItem).to.have.property('name').that.is.a('string');\r",
							"        pm.expect(catalogItem).to.have.property('description').that.is.a('string');\r",
							"        pm.expect(catalogItem).to.have.property('price').that.is.a('number');\r",
							"        pm.expect(catalogItem).to.have.property('pictureUri').that.is.a('string');\r",
							"        pm.expect(catalogItem).to.have.property('catalogTypeId').that.is.a('number');\r",
							"        pm.expect(catalogItem).to.have.property('catalogBrandId').that.is.a('number');\r",
							"    });\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Response contains pageCount\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    \r",
							"    pm.expect(responseData).to.have.property('pageCount');\r",
							"});\r",
